{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "me",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // both /about and /about/ resolve (default) — avoids the reference site's 404 bug
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // keep the me.karanshergill.workers.dev URL live alongside the custom domains
  "workers_dev": true,
  "routes": [
    { "pattern": "karanshergill.com", "custom_domain": true },
    { "pattern": "www.karanshergill.com", "custom_domain": true }
  ]
}
