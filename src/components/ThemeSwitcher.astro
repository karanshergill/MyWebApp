---
interface Props {
  size?: number;
}
const { size = 44 } = Astro.props;
---

<div class="mode-switch" role="group" aria-label="theme">
  <button class="mode-icon" data-mode="light" aria-label="Light theme" aria-pressed="false">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14.3 14.6c-1.3 2.4-4.4 3-6.3 1.3s-2.6-4.7-1-6.6 4.1-2.3 6-1 2.3 4.2 1.3 6.3z"></path>
      <path d="M12 2.6c.2 1.4-.4 2.4-.2 3.8M11.6 17.9c.2 1.7.5 2.9.8 4.3M4.1 4.6l2.1 2.6M17.4 17.3l2.9 3.4M2.1 12.4c1.4-.2 2.9.4 4.3.2M18.4 11c1.7.5 3.1-.2 4.7-.4M4.6 19.4l2.7-2.1M19.3 4.6l-2.7 2.9"></path>
    </svg>
  </button>
  <button class="mode-icon" data-mode="dark" aria-label="Dark theme" aria-pressed="false">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19.4 13.2c-.4 4.4-4 7.6-8.6 7.4S2.7 16.8 3 12.5c.2-4.1 3.7-7.7 8.3-7.4.5 0 1.2.2 1.8.3-2.4 1.8-4.1 4.7-3.7 7.8s1.7 5.7 4.1 7.1c2.2-1.2 3.7-3.2 4.4-5.4.5-1.2.9-1.9 1.5-2.7z"></path>
    </svg>
  </button>
  <button class="mode-icon" data-mode="cream" aria-label="Cream theme" aria-pressed="false">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17.4 10.1c2.4.2 3.7 2 3.1 3.9s-2.7 2.9-4.9 2.4l-.4-.1"></path>
      <path d="M4.6 10.6c-.5-1.5.8-2.9 2.4-2.9h8.8c1.7 0 2.4 1.2 2.1 2.9l-1.1 5.9c-.5 2.4-2.2 3.9-4.7 3.9h-2.2c-2.4 0-4.1-1.5-4.7-3.9l-1.4-6.4z"></path>
      <path d="M9 3.1c.5.8-.2 1.4-.5 2.4M12.4 2.2c.8 1.2-.5 2.1-.8 3.4M15.8 3.1c.5.8-.2 1.4-.5 2.4"></path>
    </svg>
  </button>
</div>

<script>
  function currentTheme(): string {
    const m = document.documentElement.className.match(/(light|dark|cream)-mode/);
    return m ? m[1] : 'light';
  }
  function sync() {
    const t = currentTheme();
    document.querySelectorAll<HTMLButtonElement>('.mode-icon[data-mode]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.mode === t));
    });
  }
  function init() {
    document.querySelectorAll<HTMLButtonElement>('.mode-switch .mode-icon').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        (window as any).__theme?.set(btn.dataset.mode);
      });
    });
    sync();
  }
  document.addEventListener('astro:page-load', init);
  document.documentElement.addEventListener('themechange', sync);
</script>
