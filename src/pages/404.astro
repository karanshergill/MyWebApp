---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404 | Karan Shergill" description="Page not found.">
  <h1 class="page-title">404</h1>
  <p class="lost-note" aria-hidden="true">this page is out of scope.</p>
  <p>The thing you were looking for isn't here. Try one of these instead:</p>
  <ul class="recovery">
    <li><a href="/">home</a></li>
    <li><a href="/projects">projects</a></li>
    <li><a href="/blog">blog</a></li>
    <li><a href="/about">about</a></li>
    <li><a href="/work">work with me</a></li>
  </ul>
</PageLayout>

<style>
  .lost-note {
    font-family: var(--font-hand);
    color: var(--ink);
    font-size: var(--hand-md);
    opacity: 0.85;
    transform: rotate(-1deg);
  }
  .recovery {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 1rem;
  }
  .recovery a {
    color: var(--link-color);
    text-decoration: underline;
  }
</style>
